# Development: leave VITE_API_BASE unset (or empty).
# Vite proxies /api -> http://localhost:5050 (see vite.config.ts).
# Do NOT set VITE_API_BASE unless you need a different API origin.
# Default direct API: http://localhost:5050 (see src/lib/api.ts).

# Production: point to your deployed API origin
# VITE_API_BASE=https://your-api.example.com
